# Copy this file to .env and fill in your real values.

# Backend server
BACKEND_PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Frontend server
FRONTEND_PORT=5173
BASE_PATH=/
API_URL=http://localhost:5000
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local-only no-key demo mode. Set false when real secrets are configured.
LOCAL_DEMO_MODE=true

# Razorpay Payment Gateway (for deployment paywall)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
